# Environment variables for Asistente IA Local
# Copy this file to .env and fill in your values

# Ollama configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Alternative: OLLAMA_MODEL=llama3.2:1b for lower RAM usage

# Embedding model for RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB vector store
CHROMA_PATH=./data/chroma
COLLECTION_NAME=documents

# Streamlit configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=true

# Document processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=3

# Resource monitoring (optional)
MONITOR_INTERVAL=0.5  # seconds between samples
MAX_SAMPLES=1000      # maximum samples to store in memory

# Logging
LOG_LEVEL=INFO